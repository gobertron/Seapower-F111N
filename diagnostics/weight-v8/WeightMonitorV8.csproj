<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RANF111NWeightMonitorV8</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">$(SEAPOWER_GAME_DIR)</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WeightProbe.cs" />
    <Compile Include="Plugin.cs" />
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)/Sea Power_Data/Managed/UnityEngine.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/Sea Power_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
